# NineEdu Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxx.apps.googleusercontent.com

# Pinata (IPFS)
NEXT_PUBLIC_GATEWAY_URL=https://your-gateway.mypinata.cloud
PINATA_JWT=your-pinata-jwt-token

# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Variables without NEXT_PUBLIC_ are only available server-side

