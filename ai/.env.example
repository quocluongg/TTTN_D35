# LLM
GEMINI_API_KEY=your_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash
LLM_TEMPERATURE=0.2

# Database (Supabase PostgreSQL)
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=your_user
DB_PASSWORD=your_password

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

# Retrieval
TOP_K=20
RERANK_TOP_K=5
MMR_LAMBDA=0.7
BM25_WEIGHT=0.50
VECTOR_WEIGHT=0.30
BUDGET_WEIGHT=0.10
RATING_WEIGHT=0.10
CE_WEIGHT=0.60

# NLU
NLU_CONFIDENCE_THRESHOLD=0.45

# Off-Topic Gate
OFF_TOPIC_THRESHOLD=0.48

# Session
SESSION_TTL=1800
SESSION_MAX_TURNS=6

# Server
HOST=0.0.0.0
PORT=8000
